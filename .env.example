# Скопируйте в .env: cp .env.example .env
# Секретов здесь нет: токен Telegram-бота вводится в веб-интерфейсе Uptime Kuma и хранится в ./data.

# Адрес, на котором слушает панель. 127.0.0.1 = только этот сервер (безопаснее). 0.0.0.0 = из сети (закрывайте файрволом и HTTPS).
KUMA_BIND=127.0.0.1
# Порт панели
KUMA_PORT=3001
# Часовой пояс (для времени в уведомлениях)
TZ=Europe/Moscow

# Только для check_ssl_expiry.py с ключом --telegram (необязательно). Не публикуйте заполненный .env.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
